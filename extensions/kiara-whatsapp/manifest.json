{
  "manifest_version": 3,
  "name": "Kiara WhatsApp",
  "description": "Conecta a sessão WhatsApp Web existente à caixa de atendimento e à operação autorizada da Kiara.",
  "version": "2.1.1",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:17843/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://kiaralead.vercel.app/*"],
      "js": ["kiara-content.js"],
      "run_at": "document_idle"
    }
  ]
}
