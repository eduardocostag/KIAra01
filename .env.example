# Copie somente as variáveis necessárias para a sua sessão. Não versione valores reais.
KIARA_LLM_PROVIDER=local
# Para usar uma camada gratuita compatível com OpenAI: groq, openrouter ou gemini.
# KIARA_LLM_PROVIDER=groq
# KIARA_LLM_MODEL=openai/gpt-oss-120b
# KIARA_LLM_FALLBACK_PROVIDER=ollama
# KIARA_LLM_FALLBACK_MODEL=kiara-stable:latest
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# Uma unica chave OpenRouter habilita Ox Alpha, Nemotron 3 Ultra e Ling 3.0 Flash.
# VERCEL_OIDC_TOKEN=
# OLLAMA_HOST=http://127.0.0.1:11434
# MICROSOFT_GRAPH_TOKEN=
# Instagram oficial (Meta). Nunca versione valores reais.
# KIARA_INSTAGRAM_ACCESS_TOKEN=
# KIARA_INSTAGRAM_APP_SECRET=
# KIARA_INSTAGRAM_VERIFY_TOKEN=
# KIARA_INSTAGRAM_ACCOUNT_ID=
# KIARA_INSTAGRAM_API_VERSION=v25.0
