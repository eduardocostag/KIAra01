[Unit]
Description=Kiara learning: team notes from the Obsidian vault (Ensinar a Kiara) + vault refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/kiara/kiara-learning-tick.sh guides
LoadCredential=env:/opt/kiara/learning/.env
DynamicUser=yes
StateDirectory=kiara-vault
StateDirectoryMode=0755
Environment=KIARA_VAULT_DIR=/var/lib/kiara-vault
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
TimeoutStartSec=120
