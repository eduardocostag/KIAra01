# Kiara gateway: the only door from the internet (Tailscale Funnel) to the Debian services.
#
# - Every route except /healthz requires `Authorization: Bearer $KIARA_GATEWAY_TOKEN`.
# - The real OmniRoute and OpenWA keys are injected here and never leave the server.
# - Only the inference API (/v1), the WhatsApp API (/api), Kokoro speech synthesis and video jobs pass;
#   dashboards, Ollama and Redis do not.
{
	admin off
	auto_https off
	persist_config off
}

http://:8088 {
	bind 127.0.0.1

	handle /healthz {
		respond "ok" 200
	}

	# OpenAI-compatible inference through OmniRoute (cloud providers + local Ollama qwen3:1.7b).
	handle /ai/v1/* {
		route {
			@denied not header Authorization "Bearer {$KIARA_GATEWAY_TOKEN}"
			respond @denied "unauthorized" 401
			uri strip_prefix /ai
			reverse_proxy 127.0.0.1:20128 {
				header_up Host {upstream_hostport}
				header_up Authorization "Bearer {$OMNIROUTE_API_KEY}"
				flush_interval -1
			}
		}
	}

	# WhatsApp REST API through OpenWA, locked down against bans: reads, linking/presence, and ONLY single text
	# replies plus the "typing" indicator. Bulk sends, media, groups, deletions and account changes never pass,
	# even with the token. The Kiara API adds the human pacing and the "only people who wrote first" rules.
	handle /wa/api/* {
		route {
			@denied not header Authorization "Bearer {$KIARA_GATEWAY_TOKEN}"
			respond @denied "unauthorized" 401
			@write {
				not method GET HEAD
				not path_regexp ^/wa/api/sessions(/[A-Za-z0-9-]+/(start|presence|messages/send-text|chats/typing))?$
			}
			respond @write "whatsapp gateway: operation not allowed" 403
			uri strip_prefix /wa
			reverse_proxy 127.0.0.1:2785 {
				header_up Host {upstream_hostport}
				header_up -Authorization
				header_up X-API-Key "{$OPENWA_API_KEY}"
			}
		}
	}

	# Kiara's offline voice (Kokoro, pf_dora). Only speech synthesis passes; at most 8 KB of text per request.
	handle /tts/v1/audio/speech {
		route {
			@denied not header Authorization "Bearer {$KIARA_GATEWAY_TOKEN}"
			respond @denied "unauthorized" 401
			@notpost not method POST
			respond @notpost "method not allowed" 405
			request_body {
				max_size 8KB
			}
			uri strip_prefix /tts
			reverse_proxy 127.0.0.1:8880 {
				header_up Host {upstream_hostport}
				header_up -Authorization
			}
		}
	}

	# Kiara video jobs (kiara-video): create a job, read its status, download the finished MP4. Nothing else.
	handle /video/* {
		route {
			@denied not header Authorization "Bearer {$KIARA_GATEWAY_TOKEN}"
			respond @denied "unauthorized" 401
			@blocked expression `!((method('POST') && path('/video/jobs')) || (method('GET') && path_regexp('^/video/jobs/[0-9a-f]{32}(/file)?$')))`
			respond @blocked "video gateway: operation not allowed" 403
			request_body {
				max_size 16KB
			}
			uri strip_prefix /video
			reverse_proxy 127.0.0.1:8891 {
				header_up Host {upstream_hostport}
				header_up -Authorization
			}
		}
	}

	handle {
		respond "not found" 404
	}
}
