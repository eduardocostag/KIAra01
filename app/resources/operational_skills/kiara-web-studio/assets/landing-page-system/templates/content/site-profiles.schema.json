{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landing.local/schemas/site-profiles.schema.json",
  "title": "Perfis comerciais dos templates",
  "type": "object",
  "required": ["version", "profiles"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "profiles": {
      "type": "array",
      "minItems": 18,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["slug", "segment", "narrativeFamily", "demo", "hero", "services", "process", "proof", "faq", "professional", "location", "contact", "publication"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "segment": { "enum": ["barbearia", "salao", "estetica", "manicure", "sobrancelhas", "odontologia", "odontopediatria", "educacao-fisica", "personal-trainer"] },
        "narrativeFamily": { "enum": ["clinical-trust", "editorial-luxury", "local-service", "performance-system", "portfolio-first", "family-care"] },
        "demo": { "const": true },
        "hero": { "$ref": "#/$defs/hero" },
        "services": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/service" } },
        "process": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/process" } },
        "proof": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/proof" } },
        "faq": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/faq" } },
        "professional": { "type": "object", "required": ["name", "registration", "credentials"], "properties": { "name": { "type": ["string", "null"] }, "registration": { "type": ["string", "null"] }, "credentials": { "type": "array", "items": { "type": "string" } } } },
        "location": { "type": "object", "required": ["city", "neighborhood", "address", "mapUrl"], "properties": { "city": { "type": ["string", "null"] }, "neighborhood": { "type": ["string", "null"] }, "address": { "type": ["string", "null"] }, "mapUrl": { "type": ["string", "null"] } } },
        "contact": { "type": "object", "required": ["whatsapp", "phone", "email", "bookingUrl"], "properties": { "whatsapp": { "type": ["string", "null"] }, "phone": { "type": ["string", "null"] }, "email": { "type": ["string", "null"] }, "bookingUrl": { "type": ["string", "null"] } } },
        "publication": { "type": "object", "required": ["status", "requiredProfile"], "properties": { "status": { "const": "blocked-demo" }, "requiredProfile": { "type": "string" } } }
      }
    },
    "hero": { "type": "object", "required": ["eyebrow", "headline", "subheadline", "primaryCta", "secondaryCta"], "properties": { "eyebrow": { "type": "string" }, "headline": { "type": "string" }, "subheadline": { "type": "string" }, "primaryCta": { "type": "string" }, "secondaryCta": { "type": "string" } } },
    "service": { "type": "object", "required": ["name", "forWhom", "includes", "duration", "modality", "priceMode", "cta"], "properties": { "name": { "type": "string" }, "forWhom": { "type": "string" }, "includes": { "type": "array", "minItems": 2, "items": { "type": "string" } }, "duration": { "type": "string" }, "modality": { "type": "string" }, "priceMode": { "enum": ["quote", "from", "fixed", "assessment"] }, "cta": { "type": "string" } } },
    "process": { "type": "object", "required": ["title", "description"], "properties": { "title": { "type": "string" }, "description": { "type": "string" } } },
    "proof": { "type": "object", "required": ["kind", "demoLabel", "approved"], "properties": { "kind": { "enum": ["testimonial", "case", "portfolio", "metric", "credential"] }, "demoLabel": { "type": "string" }, "approved": { "const": false } } },
    "faq": { "type": "object", "required": ["question", "answer"], "properties": { "question": { "type": "string" }, "answer": { "type": "string" } } }
  }
}
